<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.1</Version>
    <Authors>SysTune contributors</Authors>
    <Product>SysTune</Product>
    <Copyright>Copyright © 2026 SysTune contributors</Copyright>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CA1303;CA1848;CA1716;CA1031;CA1062;CA1805;CA2007;CA1001;CA1724;CA1305;CA1307;CA1309;CA1310;CA1822;CA5394;CA1515;CA1416;CA1056;CA1054;CA1002;CA2227;CA1819;CA1034;CA1708;CA1711;CA1720;CA1027;CA1028;CA1069;CA1401;CA1838;CA2101;CA1806;CA1860;CA1859;CA1812;CA1852;CA1863;CA1508</NoWarn>
  </PropertyGroup>
</Project>
