<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <!-- Tint over the system blur: cool, slightly blue-tinted smoked glass -->
    <Color x:Key="Color.Tint">#FF10131A</Color>
    <SolidColorBrush x:Key="Brush.Tint" Color="{StaticResource Color.Tint}" />
    <SolidColorBrush x:Key="Brush.Solid" Color="#FF1B1E24" />
    <!-- Diagonal light sheen across the glass -->
    <LinearGradientBrush x:Key="Brush.Sheen" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1FFFFFFF" Offset="0" />
        <GradientStop Color="#08FFFFFF" Offset="0.38" />
        <GradientStop Color="#00FFFFFF" Offset="0.6" />
        <GradientStop Color="#06FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- Glass edge: light catches the top-left rim, fades toward bottom-right -->
    <LinearGradientBrush x:Key="Brush.Stroke" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#66FFFFFF" Offset="0" />
        <GradientStop Color="#1FFFFFFF" Offset="0.45" />
        <GradientStop Color="#0FFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Divider" Color="#17FFFFFF" />
    <LinearGradientBrush x:Key="Brush.Tile" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#17FFFFFF" Offset="0" />
        <GradientStop Color="#0AFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.TileStroke" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#33FFFFFF" Offset="0" />
        <GradientStop Color="#0AFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Track" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Brush.Menu" Color="#EB1C1F26" />
    <SolidColorBrush x:Key="Brush.Input" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.InputStroke" Color="#24FFFFFF" />
    <Color x:Key="Color.Shadow">#99000000</Color>

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Text1" Color="#FFF3F5F8" />
    <SolidColorBrush x:Key="Brush.Text2" Color="#C2D4D8E0" />
    <SolidColorBrush x:Key="Brush.Text3" Color="#80C9CED8" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FF0B0D10" />

    <!-- Accents -->
    <SolidColorBrush x:Key="Brush.Cpu" Color="#FF5AC8FA" />
    <SolidColorBrush x:Key="Brush.Gpu" Color="#FFB197FC" />
    <SolidColorBrush x:Key="Brush.Mem" Color="#FF4ADE9A" />
    <SolidColorBrush x:Key="Brush.Down" Color="#FF60A5FA" />
    <SolidColorBrush x:Key="Brush.Up" Color="#FFF472B6" />
    <SolidColorBrush x:Key="Brush.Disk" Color="#FFFBBF24" />
    <SolidColorBrush x:Key="Brush.Spotify" Color="#FF1ED760" />
    <SolidColorBrush x:Key="Brush.Warn" Color="#FFFBBF24" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFF87171" />
    <SolidColorBrush x:Key="Brush.PlayButton" Color="#FFF3F5F8" />
</ResourceDictionary>
