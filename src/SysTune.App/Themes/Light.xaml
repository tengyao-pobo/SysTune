<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <Color x:Key="Color.Tint">#FFF4F5F8</Color>
    <SolidColorBrush x:Key="Brush.Tint" Color="{StaticResource Color.Tint}" />
    <SolidColorBrush x:Key="Brush.Solid" Color="#FFF6F7F9" />
    <LinearGradientBrush x:Key="Brush.Sheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FFFFFF" Offset="0" />
        <GradientStop Color="#1AFFFFFF" Offset="0.4" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Stroke" Color="#1F000000" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#14000000" />
    <SolidColorBrush x:Key="Brush.Tile" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="Brush.TileStroke" Color="#0F000000" />
    <SolidColorBrush x:Key="Brush.Track" Color="#17000000" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#12000000" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#0A000000" />
    <SolidColorBrush x:Key="Brush.Menu" Color="#F7FAFAFC" />
    <SolidColorBrush x:Key="Brush.Input" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="Brush.InputStroke" Color="#24000000" />
    <Color x:Key="Color.Shadow">#33000000</Color>

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Text1" Color="#FF14171C" />
    <SolidColorBrush x:Key="Brush.Text2" Color="#FF4A5260" />
    <SolidColorBrush x:Key="Brush.Text3" Color="#FF7D8594" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFFFF" />

    <!-- Accents (darker for contrast on light glass) -->
    <SolidColorBrush x:Key="Brush.Cpu" Color="#FF0A84D6" />
    <SolidColorBrush x:Key="Brush.Gpu" Color="#FF7C3AED" />
    <SolidColorBrush x:Key="Brush.Mem" Color="#FF059669" />
    <SolidColorBrush x:Key="Brush.Down" Color="#FF2563EB" />
    <SolidColorBrush x:Key="Brush.Up" Color="#FFDB2777" />
    <SolidColorBrush x:Key="Brush.Disk" Color="#FFD97706" />
    <SolidColorBrush x:Key="Brush.Spotify" Color="#FF1AA34A" />
    <SolidColorBrush x:Key="Brush.Warn" Color="#FFB45309" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFDC2626" />
    <SolidColorBrush x:Key="Brush.PlayButton" Color="#FF14171C" />
</ResourceDictionary>
