<Window x:Class="SysTune.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SysTune.App.Controls"
        xmlns:vm="clr-namespace:SysTune.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="SysTune"
        Width="340"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource Brush.Text1}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale">


    <Window.Resources>
        <Style x:Key="HeaderButtons" TargetType="StackPanel">
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" BeginTime="0:0:0.6" Duration="0:0:0.25" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" BeginTime="0:0:0.6" Duration="0:0:0.25" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Metric tile -->
        <Style x:Key="TileTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}" />
        <Style x:Key="TempChip" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Glass layers: tint (opacity adjustable) + sheen + hairline stroke -->
        <Border x:Name="Tint" CornerRadius="{DynamicResource WindowCorner}" Background="{DynamicResource Brush.Tint}" Opacity="{Binding TintOpacity}" />
        <Border CornerRadius="{DynamicResource WindowCorner}" Background="{DynamicResource Brush.Sheen}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" />

        <Grid x:Name="ContentRoot">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
            </Grid.LayoutTransform>

            <!-- ================= EXPANDED ================= -->
            <StackPanel x:Name="Expanded" Width="340" Margin="0,0,0,12" Visibility="{Binding IsCompact, Converter={StaticResource Visible}, ConverterParameter=invert}">

                <!-- Header -->
                <Grid Margin="14,8,8,0" Height="28">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="{DynamicResource Brush.Spotify}" />
                        <TextBlock Text="SysTune" Style="{StaticResource Text.Label}" Foreground="{DynamicResource Brush.Text2}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Style="{StaticResource HeaderButtons}">
                        <Button Style="{StaticResource IconButton}" Content="{Binding TopmostGlyph}" Command="{Binding ToggleTopmostCommand}"
                                ToolTip="永遠置頂" AutomationProperties.Name="永遠置頂" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE73F;" Command="{Binding ToggleModeCommand}"
                                ToolTip="精簡模式" AutomationProperties.Name="切換精簡模式" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" Command="{Binding OpenSettingsCommand}"
                                ToolTip="設定" AutomationProperties.Name="設定" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE921;" Command="{Binding HideCommand}"
                                ToolTip="隱藏到通知區" AutomationProperties.Name="隱藏" />
                    </StackPanel>
                </Grid>

                <!-- ===== Now playing ===== -->
                <Grid Margin="14,6,14,0" DataContext="{Binding Player}"
                      Visibility="{Binding DataContext.ShowSpotify, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">

                    <!-- Track -->
                    <StackPanel Visibility="{Binding HasTrack, Converter={StaticResource Visible}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="76" Height="76" CornerRadius="8" Background="{DynamicResource Brush.Tile}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource Color.Shadow}" BlurRadius="14" ShadowDepth="3" Opacity="0.5" RenderingBias="Performance" />
                                </Border.Effect>
                                <Grid>
                                    <TextBlock Text="&#xEC4F;" Style="{StaticResource Text.Icon}" FontSize="24" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Text3}" />
                                    <Border CornerRadius="8">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,2,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" ToolTip="{Binding Title}" />
                                <TextBlock Text="{Binding Artist}" Style="{StaticResource Text.Body}" Margin="0,2,0,0" ToolTip="{Binding Album}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding DeviceGlyph}" Style="{StaticResource Text.Icon}" FontSize="11" Foreground="{DynamicResource Brush.Spotify}" />
                                    <TextBlock Text="{Binding DeviceName}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Spotify}" Margin="5,0,0,0" MaxWidth="120" />
                                    <TextBlock Text=" · " Style="{StaticResource Text.Caption}" />
                                    <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Progress -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PositionText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                            <Slider x:Name="SeekBar" Grid.Column="1" Style="{StaticResource GlassSlider}" Minimum="0"
                                    Maximum="{Binding DurationMs}" Value="{Binding PositionMs, Mode=OneWay}" IsEnabled="{Binding CanSeek}"
                                    AutomationProperties.Name="播放進度" SmallChange="5000" LargeChange="15000" />
                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Transport -->
                        <Grid Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Content="&#xE8B1;" c:Ui.IsActive="{Binding Shuffle}" Command="{Binding ToggleShuffleCommand}" IsEnabled="{Binding CanControl}"
                                        ToolTip="隨機播放" AutomationProperties.Name="隨機播放" Margin="0,0,6,0" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE892;" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanControl}" FontSize="14"
                                        ToolTip="上一首" AutomationProperties.Name="上一首" Margin="0,0,6,0" />
                                <Button Style="{StaticResource PlayButton}" Content="{Binding PlayGlyph}" Command="{Binding PlayPauseCommand}" IsEnabled="{Binding CanControl}"
                                        ToolTip="播放 / 暫停" AutomationProperties.Name="播放或暫停" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE893;" Command="{Binding NextCommand}" IsEnabled="{Binding CanControl}" FontSize="14"
                                        ToolTip="下一首" AutomationProperties.Name="下一首" Margin="6,0,0,0" />
                                <Button Style="{StaticResource IconButton}" Content="{Binding RepeatGlyph}" c:Ui.IsActive="{Binding RepeatActive}" Command="{Binding CycleRepeatCommand}" IsEnabled="{Binding CanControl}"
                                        ToolTip="重複播放" AutomationProperties.Name="重複播放" Margin="6,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ToggleButton x:Name="VolumeToggle" Style="{StaticResource IconButton}" Content="&#xE767;" Visibility="{Binding HasVolume, Converter={StaticResource Visible}}"
                                              IsHitTestVisible="{Binding IsOpen, ElementName=VolumePopup, Converter={StaticResource Not}}"
                                              ToolTip="音量" AutomationProperties.Name="音量" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE8AF;" Command="{Binding OpenDevicesCommand}"
                                        Visibility="{Binding IsConnect, Converter={StaticResource Visible}}"
                                        ToolTip="Spotify Connect 裝置" AutomationProperties.Name="切換播放裝置" />
                            </StackPanel>
                        </Grid>

                        <!-- Volume popup -->
                        <Popup x:Name="VolumePopup" IsOpen="{Binding IsChecked, ElementName=VolumeToggle}" StaysOpen="False" PlacementTarget="{Binding ElementName=VolumeToggle}"
                               Placement="Top" AllowsTransparency="True" PopupAnimation="Fade" Closed="VolumePopup_Closed">
                            <Border Background="{DynamicResource Brush.Menu}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE767;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Text2}" />
                                    <Slider x:Name="VolumeSlider" Width="140" Margin="10,0" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="100"
                                            Value="{Binding Volume, Mode=OneWay}" ValueChanged="Volume_ValueChanged" AutomationProperties.Name="音量" SmallChange="5" LargeChange="10" />
                                    <TextBlock Text="{Binding Volume, StringFormat={}{0:0}}" Style="{StaticResource Text.Caption}" Width="22" />
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Device picker popup -->
                        <Popup IsOpen="{Binding IsDevicePickerOpen}" StaysOpen="False" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Brush.Menu}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="6" Width="280">
                                <StackPanel>
                                    <TextBlock Text="選擇播放裝置" Style="{StaticResource Text.Label}" Margin="8,4,8,6" />
                                    <TextBlock Text="正在尋找裝置…" Style="{StaticResource Text.Caption}" Margin="8,4" Visibility="{Binding IsLoadingDevices, Converter={StaticResource Visible}}" />
                                    <ItemsControl ItemsSource="{Binding Devices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:DeviceItem}">
                                                <Button Command="{Binding DataContext.TransferCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsSelectable}" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" CornerRadius="6" Padding="8,6" Background="Transparent">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="26" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="14" Foreground="{DynamicResource Brush.Text2}" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Brush.Text1}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Brush.Spotify}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <!-- Empty / not connected -->
                    <Border Style="{StaticResource Tile}" Padding="12" Visibility="{Binding HasTrack, Converter={StaticResource Visible}, ConverterParameter=invert}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Brush.Track}" VerticalAlignment="Top">
                                <TextBlock Text="&#xEC4F;" Style="{StaticResource Text.Icon}" FontSize="16" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Spotify}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="{Binding EmptyTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text1}" />
                                <TextBlock Text="{Binding EmptySubtitle}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource AccentButton}" Content="連結 Spotify" Command="{Binding ConnectCommand}"
                                            Visibility="{Binding ShowConnectButton, Converter={StaticResource Visible}}" />
                                    <Button Style="{StaticResource SubtleButton}" Content="開啟 Spotify" Command="{Binding OpenSpotifyCommand}"
                                            Visibility="{Binding ShowOpenSpotifyButton, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Message -->
                <Border Margin="14,8,14,0" Padding="10,6" CornerRadius="6" Background="{DynamicResource Brush.Tile}"
                        DataContext="{Binding Player}" Visibility="{Binding Message, Converter={StaticResource Visible}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{DynamicResource Brush.Warn}" />
                        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text2}" TextWrapping="Wrap" TextTrimming="None" Margin="8,0,0,0" MaxWidth="270" />
                    </StackPanel>
                </Border>

                <!-- Divider -->
                <Border Height="1" Margin="14,12,14,0" Background="{DynamicResource Brush.Divider}"
                        Visibility="{Binding ShowSpotify, Converter={StaticResource Visible}}" />

                <!-- ===== Metric tiles ===== -->
                <UniformGrid Columns="2" Margin="10,8,10,0" DataContext="{Binding System}"
                             Visibility="{Binding DataContext.ShowTiles, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">

                    <!-- CPU -->
                    <Border Style="{StaticResource Tile}" Margin="4" ToolTip="{Binding CpuName}"
                            Visibility="{Binding DataContext.ShowCpu, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="CPU" Style="{StaticResource TileTitle}" />
                            <TextBlock Text="{Binding CpuTempText}" Style="{StaticResource TempChip}" ToolTip="{Binding CpuTempTooltip}" />
                            <TextBlock Grid.Row="1" Text="{Binding CpuUsageText}" Style="{StaticResource Text.Metric}" Margin="0,2,0,0" />
                            <c:Sparkline Grid.Row="2" Height="22" Margin="0,2,0,2" Values="{Binding CpuHistory}" Stroke="{DynamicResource Brush.Cpu}" />
                            <TextBlock Grid.Row="3" Text="{Binding CpuDetailText}" Style="{StaticResource Text.Caption}" />
                        </Grid>
                    </Border>

                    <!-- GPU -->
                    <Border Style="{StaticResource Tile}" Margin="4" ToolTip="{Binding GpuName}"
                            Visibility="{Binding DataContext.ShowGpu, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="GPU" Style="{StaticResource TileTitle}" />
                            <TextBlock Text="{Binding GpuTempText}" Style="{StaticResource TempChip}" />
                            <TextBlock Grid.Row="1" Text="{Binding GpuUsageText}" Style="{StaticResource Text.Metric}" Margin="0,2,0,0" />
                            <c:Sparkline Grid.Row="2" Height="22" Margin="0,2,0,2" Values="{Binding GpuHistory}" Stroke="{DynamicResource Brush.Gpu}" />
                            <TextBlock Grid.Row="3" Text="{Binding GpuDetailText}" Style="{StaticResource Text.Caption}" />
                            <TextBlock Grid.Row="1" Grid.RowSpan="3" Text="未偵測到硬體 GPU" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                                       Visibility="{Binding HasGpu, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                        </Grid>
                    </Border>

                    <!-- Memory -->
                    <Border Style="{StaticResource Tile}" Margin="4" ToolTip="{Binding MemTooltip}"
                            Visibility="{Binding DataContext.ShowMemory, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="記憶體" Style="{StaticResource TileTitle}" />
                            <TextBlock Grid.Row="1" Text="{Binding MemPercentText}" Style="{StaticResource Text.Metric}" Margin="0,2,0,0" />
                            <c:Sparkline Grid.Row="2" Height="22" Margin="0,2,0,2" Values="{Binding MemHistory}" Stroke="{DynamicResource Brush.Mem}" />
                            <TextBlock Grid.Row="3" Text="{Binding MemDetailText}" Style="{StaticResource Text.Caption}" />
                        </Grid>
                    </Border>

                    <!-- Network -->
                    <Border Style="{StaticResource Tile}" Margin="4" ToolTip="{Binding NetAdapterText}"
                            Visibility="{Binding DataContext.ShowNetwork, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="網路" Style="{StaticResource TileTitle}" />
                            <TextBlock Text="離線" Style="{StaticResource TempChip}" Foreground="{DynamicResource Brush.Danger}"
                                       Visibility="{Binding NetConnected, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                            <StackPanel Grid.Row="1" Margin="0,3,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74B;" Style="{StaticResource Text.Icon}" FontSize="10" Foreground="{DynamicResource Brush.Down}" />
                                    <TextBlock Text="{Binding NetDownText}" FontSize="13" FontWeight="SemiBold" Margin="5,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <TextBlock Text="&#xE74A;" Style="{StaticResource Text.Icon}" FontSize="10" Foreground="{DynamicResource Brush.Up}" />
                                    <TextBlock Text="{Binding NetUpText}" FontSize="13" FontWeight="SemiBold" Margin="5,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Grid Grid.Row="2" Height="20" Margin="0,2,0,2">
                                <c:Sparkline Values="{Binding NetDownHistory}" Stroke="{DynamicResource Brush.Down}" AutoScale="True" />
                                <c:Sparkline Values="{Binding NetUpHistory}" Stroke="{DynamicResource Brush.Up}" AutoScale="True" ShowFill="False" />
                            </Grid>
                            <TextBlock Grid.Row="3" Text="{Binding NetAdapterText}" Style="{StaticResource Text.Caption}" />
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- ===== Storage ===== -->
                <StackPanel Margin="14,10,14,0" DataContext="{Binding System}"
                            Visibility="{Binding DataContext.ShowDisks, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="儲存空間" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding DiskActivityText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" MaxWidth="230" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DriveItem}">
                                <Grid Margin="0,3" ToolTip="{Binding Tooltip}" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text2}" VerticalAlignment="Center" />
                                    <c:Meter x:Name="Bar" Grid.Column="1" Height="5" VerticalAlignment="Center" Value="{Binding UsedPercent}"
                                             Fill="{DynamicResource Brush.Disk}" Track="{DynamicResource Brush.Track}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Text}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="Warn">
                                        <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource Brush.Warn}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Danger">
                                        <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Footer -->
                <Grid Margin="14,10,14,0" DataContext="{Binding System}">
                    <TextBlock Text="{Binding UptimeText}" Style="{StaticResource Text.Caption}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding HasBattery, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding BatteryGlyph}" Style="{StaticResource Text.Icon}" FontSize="11" Foreground="{DynamicResource Brush.Text3}" />
                        <TextBlock Text="{Binding BatteryText}" Style="{StaticResource Text.Caption}" Margin="5,0,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ================= COMPACT ================= -->
            <Grid x:Name="Compact" Width="460" Height="56" Visibility="{Binding IsCompact, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Music -->
                <Grid Margin="10,0,6,0" DataContext="{Binding Player}"
                      Visibility="{Binding DataContext.ShowSpotify, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="6" Background="{DynamicResource Brush.Tile}" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="&#xEC4F;" Style="{StaticResource Text.Icon}" FontSize="14" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Spotify}" />
                            <Border CornerRadius="6">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasTrack, Converter={StaticResource Visible}}" ToolTip="{Binding Title}" />
                        <TextBlock Text="{Binding Artist}" Style="{StaticResource Text.Caption}"
                                   Visibility="{Binding HasTrack, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding EmptyTitle}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasTrack, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasTrack, Converter={StaticResource Visible}}">
                        <Button Style="{StaticResource IconButton}" Content="{Binding PlayGlyph}" Command="{Binding PlayPauseCommand}" IsEnabled="{Binding CanControl}" FontSize="13"
                                ToolTip="播放 / 暫停" AutomationProperties.Name="播放或暫停" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" Command="{Binding NextCommand}" IsEnabled="{Binding CanControl}"
                                ToolTip="下一首" AutomationProperties.Name="下一首" />
                    </StackPanel>
                    <!-- thin progress line under the pill -->
                    <c:Meter Grid.ColumnSpan="3" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,3" Track="Transparent" Fill="{DynamicResource Brush.Spotify}"
                             Value="{Binding PositionPercent}" Opacity="0.8"
                             Visibility="{Binding HasTrack, Converter={StaticResource Visible}}" />
                </Grid>

                <!-- Stats -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0" DataContext="{Binding System}">
                    <Border Width="1" Margin="2,14,8,14" Background="{DynamicResource Brush.Divider}" />
                    <StackPanel Margin="4,0" VerticalAlignment="Center" ToolTip="{Binding CpuName}"
                                Visibility="{Binding DataContext.ShowCpu, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                        <TextBlock Text="CPU" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Cpu}" />
                        <TextBlock Text="{Binding CpuUsageText}" FontSize="13" FontWeight="SemiBold" MinWidth="34" />
                    </StackPanel>
                    <StackPanel Margin="4,0" VerticalAlignment="Center" ToolTip="{Binding GpuName}"
                                Visibility="{Binding DataContext.ShowGpu, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                        <TextBlock Text="GPU" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Gpu}" />
                        <TextBlock Text="{Binding GpuUsageText}" FontSize="13" FontWeight="SemiBold" MinWidth="34" />
                    </StackPanel>
                    <StackPanel Margin="4,0" VerticalAlignment="Center" ToolTip="{Binding MemDetailText}"
                                Visibility="{Binding DataContext.ShowMemory, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                        <TextBlock Text="RAM" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Mem}" />
                        <TextBlock Text="{Binding MemPercentText}" FontSize="13" FontWeight="SemiBold" MinWidth="34" />
                    </StackPanel>
                    <StackPanel Margin="4,0,0,0" VerticalAlignment="Center" MinWidth="58"
                                Visibility="{Binding DataContext.ShowNetwork, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74B;" Style="{StaticResource Text.Icon}" FontSize="9" Foreground="{DynamicResource Brush.Down}" />
                            <TextBlock Text="{Binding NetDownShort}" FontSize="11.5" FontWeight="SemiBold" Margin="4,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74A;" Style="{StaticResource Text.Icon}" FontSize="9" Foreground="{DynamicResource Brush.Up}" />
                            <TextBlock Text="{Binding NetUpShort}" FontSize="11.5" FontWeight="SemiBold" Margin="4,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" Content="&#xE740;" Width="24" Margin="6,0,0,0" FontSize="11"
                            Command="{Binding DataContext.ToggleModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="展開" AutomationProperties.Name="展開模式" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Width resize grip (scales the widget) -->
        <Thumb x:Name="ResizeGrip" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
               DragDelta="ResizeGrip_DragDelta" DragCompleted="ResizeGrip_DragCompleted" ToolTip="拖曳以調整大小">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M 10,3 L 3,10 M 10,7 L 7,10" Stroke="{DynamicResource Brush.Text3}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Opacity="{Binding Opacity, ElementName=GripOpacity}" />
                        <FrameworkElement x:Name="GripOpacity" Opacity="0.0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter TargetName="GripOpacity" Property="Opacity" Value="0.9" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
