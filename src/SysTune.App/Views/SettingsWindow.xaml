<Window x:Class="SysTune.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SysTune.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        Title="SysTune 設定"
        Width="460" Height="640" MinWidth="400" MinHeight="420"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource Brush.Text1}"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="Grayscale">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text1}" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Margin" Value="0,2,0,6" />
            <Setter Property="LineHeight" Value="16" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text1}" />
            <Setter Property="Margin" Value="0,8,0,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="Tint" CornerRadius="{DynamicResource WindowCorner}" Background="{DynamicResource Brush.Tint}" Opacity="0.82" />
        <Border CornerRadius="{DynamicResource WindowCorner}" Background="{DynamicResource Brush.Sheen}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Margin="18,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE713;" Style="{StaticResource Text.Icon}" FontSize="14" Foreground="{DynamicResource Brush.Spotify}" />
                    <TextBlock Text="設定" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Click="Close_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="關閉" AutomationProperties.Name="關閉設定" />
            </Grid>

            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,22" Focusable="False">
                <StackPanel>

                    <!-- ===== Appearance ===== -->
                    <TextBlock Text="外觀" Style="{StaticResource Section}" Margin="0,4,0,8" />
                    <TextBlock Text="主題" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <WrapPanel>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="跟隨系統" IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=System}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="深色" IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Dark}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="淺色" IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Light}" />
                    </WrapPanel>

                    <TextBlock Text="玻璃效果" Style="{StaticResource FieldLabel}" />
                    <WrapPanel>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Glass" Content="壓克力" IsChecked="{Binding Glass, Converter={StaticResource EnumEquals}, ConverterParameter=Acrylic}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Glass" Content="模糊" IsChecked="{Binding Glass, Converter={StaticResource EnumEquals}, ConverterParameter=Blur}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Glass" Content="系統背景" IsChecked="{Binding Glass, Converter={StaticResource EnumEquals}, ConverterParameter=SystemBackdrop}"
                                     Visibility="{Binding SupportsSystemBackdrop, Converter={StaticResource Visible}}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Glass" Content="關閉" IsChecked="{Binding Glass, Converter={StaticResource EnumEquals}, ConverterParameter=Off}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding GlassNote}" Style="{StaticResource Hint}" />

                    <Grid Margin="0,6,0,0">
                        <TextBlock Text="背景不透明度" Style="{StaticResource FieldLabel}" Margin="0" />
                        <TextBlock Text="{Binding TintOpacityPercent, StringFormat={}{0:0}%}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider Style="{StaticResource GlassSlider}" Minimum="20" Maximum="100" Margin="0,6,0,0" SmallChange="1" LargeChange="10"
                            Foreground="{DynamicResource Brush.Spotify}" Value="{Binding TintOpacityPercent}" AutomationProperties.Name="背景不透明度" />

                    <!-- ===== Behaviour ===== -->
                    <TextBlock Text="行為" Style="{StaticResource Section}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="永遠置頂" IsChecked="{Binding AlwaysOnTop}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="鎖定位置（停用拖曳與縮放）" IsChecked="{Binding LockPosition}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="開機時自動啟動" IsChecked="{Binding StartWithWindows}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="自動啟動時隱藏到通知區" IsChecked="{Binding StartHidden}" IsEnabled="{Binding StartWithWindows}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="在工作列與 Alt+Tab 顯示" IsChecked="{Binding ShowInTaskbar}" />
                    <Button Style="{StaticResource SubtleButton}" Content="重設小工具位置" Command="{Binding ResetPositionCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />

                    <!-- ===== Monitoring ===== -->
                    <TextBlock Text="系統監控" Style="{StaticResource Section}" />
                    <TextBlock Text="更新頻率" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <WrapPanel>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Refresh" Content="0.5 秒" IsChecked="{Binding RefreshInterval, Converter={StaticResource EnumEquals}, ConverterParameter=500}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Refresh" Content="1 秒" IsChecked="{Binding RefreshInterval, Converter={StaticResource EnumEquals}, ConverterParameter=1000}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Refresh" Content="2 秒" IsChecked="{Binding RefreshInterval, Converter={StaticResource EnumEquals}, ConverterParameter=2000}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Refresh" Content="5 秒" IsChecked="{Binding RefreshInterval, Converter={StaticResource EnumEquals}, ConverterParameter=5000}" />
                    </WrapPanel>
                    <TextBlock Text="間隔越長越省電。小工具隱藏時會自動降為每 5 秒取樣一次（僅供通知區提示）。" Style="{StaticResource Hint}" />
                    <TextBlock Text="顯示項目" Style="{StaticResource FieldLabel}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Spotify 播放資訊" IsChecked="{Binding ShowSpotify}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="CPU" IsChecked="{Binding ShowCpu}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="GPU" IsChecked="{Binding ShowGpu}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="記憶體" IsChecked="{Binding ShowMemory}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="網路" IsChecked="{Binding ShowNetwork}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="儲存空間" IsChecked="{Binding ShowDisks}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="溫度以華氏顯示" IsChecked="{Binding UseFahrenheit}" />
                    <TextBlock Text="{Binding SensorNote}" Style="{StaticResource Hint}" />

                    <!-- ===== Spotify ===== -->
                    <TextBlock x:Name="SpotifySection" Text="Spotify" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Tile}" Padding="12">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Text3}" x:Name="StatusDot" />
                                    <TextBlock Text="{Binding SpotifyStatusText}" FontSize="12.5" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource AccentButton}" Content="連結 Spotify" Command="{Binding ConnectSpotifyCommand}"
                                            Visibility="{Binding IsSpotifyConnected, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                                    <Button Style="{StaticResource SubtleButton}" Content="中斷連結" Command="{Binding DisconnectSpotifyCommand}"
                                            Visibility="{Binding IsSpotifyConnected, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding SpotifyError}" Style="{StaticResource Hint}" Foreground="{DynamicResource Brush.Danger}" Margin="0,8,0,0"
                                       Visibility="{Binding SpotifyError, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Client ID" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource GlassTextBox}" Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged, Delay=400}" AutomationProperties.Name="Spotify Client ID" />
                    <TextBlock Style="{StaticResource Hint}">
                        <Run Text="在 Spotify Developer Dashboard 建立應用程式（勾選 Web API），將下方 Redirect URI 加入應用程式設定，再貼上 Client ID。使用 PKCE 授權，不需要也不會儲存 Client Secret。" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Button Style="{StaticResource SubtleButton}" Content="開啟 Developer Dashboard" Command="{Binding OpenDashboardCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource SubtleButton}" Content="設定指南" Command="{Binding OpenGuideCommand}" />
                    </StackPanel>

                    <TextBlock Text="Redirect URI" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource GlassTextBox}" Text="{Binding RedirectUri, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Redirect URI" />
                        <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Content="複製" Command="{Binding CopyRedirectUriCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="回呼連接埠" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource GlassTextBox}" Width="90" HorizontalAlignment="Right" Text="{Binding CallbackPort, UpdateSourceTrigger=PropertyChanged, Delay=500}" AutomationProperties.Name="回呼連接埠" />
                    </Grid>
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="未連結時使用本機 Spotify 桌面版（Windows 媒體工作階段）" IsChecked="{Binding UseLocalMediaSession}" Margin="0,10,0,0" />
                    <TextBlock Text="本機模式不需登入，但只能顯示此電腦上的 Spotify 播放，且無法切換裝置或調整 Spotify Connect 音量。播放控制需要 Spotify Premium。" Style="{StaticResource Hint}" />

                    <!-- ===== About ===== -->
                    <TextBlock Text="關於" Style="{StaticResource Section}" />
                    <TextBlock Text="{Binding VersionText}" FontSize="12.5" />
                    <TextBlock Text="快捷鍵：空白鍵 播放/暫停 · Ctrl+←/→ 上/下一首 · Ctrl+, 設定 · Esc 隱藏" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                    <Button Style="{StaticResource SubtleButton}" Content="開啟記錄檔資料夾" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
